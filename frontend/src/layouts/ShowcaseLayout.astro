---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';
interface Props { title?: string; description?: string; }
const { title, description = 'Components, interactions and interface patterns in Terracotta Minimalist Brutalism.' } = Astro.props;
const links = [['Foundations','/foundations/'],['Components','/components/'],['Patterns','/patterns/'],['Motion','/motion/']];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4ed" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/lexend-deca-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inclusive-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title ? `${title} — Arifian Design System` : 'Arifian Design System — Interfaces with intent'}</title>
    <script is:inline>
      try { const theme = localStorage.getItem('arifian-design-theme-v1'); if (theme === 'dark') { document.documentElement.dataset.theme = 'dark'; document.documentElement.style.colorScheme = 'dark'; document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#141413'); } } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header" data-site-header>
      <div class="header-inner"><a class="wordmark" href="/" aria-label="Arifian Design System home"><span class="brand-mark" aria-hidden="true"></span><span>Arifian<span class="wordmark-sub"> / Design System</span></span></a>
      <nav class="desktop-nav" aria-label="Main navigation">{links.map(([label,href])=><a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>{label}</a>)}</nav>
      <div class="header-controls"><ThemeToggle client:load /><details class="mobile-navigation"><summary aria-label="Open navigation"><span>Menu</span><span aria-hidden="true">＋</span></summary><nav aria-label="Mobile navigation">{links.map(([label,href])=><a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>{label}<span aria-hidden="true">↗</span></a>)}</nav></details></div></div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer"><div class="footer-top"><a class="wordmark" href="/"><span class="brand-mark" aria-hidden="true"></span>Arifian Design System</a><p>Considered parts.<br />Useful possibilities.</p><a class="text-link" href="/about/">About the system <span aria-hidden="true">↗</span></a></div><div class="footer-bottom"><span>Terracotta Minimalist Brutalism</span><span>Made with attention to the details.</span><a href="/originals/">Arifian Originals</a><a href="#main">Back to top ↑</a></div></footer>
    <noscript><p class="noscript-note">All pages and specimen previews are readable. Interactive controls need JavaScript.</p></noscript>
  </body>
</html>
