---
import '../styles/global.css';
import CinematicHome from '../components/CinematicHome';
import Workbench from '../components/Workbench';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="A cinematic design archive exploring visual systems through color, type, shape, composition and motion." />
    <title>Design Archive — A visual library of complete design systems</title>
  </head>
  <body>
    <main id="content">
      <CinematicHome client:load />
      <section id="workbench" class="workbench-entry" aria-label="Design workbench">
        {import.meta.env.DEV ? <Workbench client:only="react" source="/__local/specimens" /> : <section class="locked"><p>Design workbench</p><h1>Collection locked</h1><p>Design profiles require authorized access. No design documents are included in this build.</p></section>}
      </section>
    </main>
    <noscript><p>Scroll story animations are optional; the workbench requires JavaScript.</p></noscript>
  </body>
</html>
