---
import { Specimen } from './Specimens';
import type { CatalogEntry } from '../lib/catalog';
interface Props { entry: CatalogEntry; }
const { entry } = Astro.props;
const wide = entry.kind === 'pattern' || ['carousel','profile-bento','table','chat-composer','message-board'].includes(entry.slug);
---
<article id={entry.slug} class:list={['specimen-card', { 'wide-specimen': wide }]}>
  <header><div><span>{entry.category.replace('-', ' ')} / {entry.status}</span><span>{entry.kind}</span></div><h2><a href={`#${entry.slug}`}>{entry.name}</a></h2><p>{entry.summary}</p></header>
  <Specimen slug={entry.slug} client:visible />
  <footer><span>{entry.origin} · {entry.license}</span><details><summary>Behavior & notes</summary><p>{entry.motion}</p><p>States: {entry.states.join(' / ')}. Synthetic content; changes stay in this preview.</p></details></footer>
</article>
